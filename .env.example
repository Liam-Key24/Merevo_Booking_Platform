# =============================================================================
# Merevo Booking Platform — environment variables
# Copy to .env.local and fill in values. Never commit real secrets.
# =============================================================================

# --- Required (public / browser-safe) -----------------------------------------
# Supabase project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon / publishable key (Settings → API) — never the service role key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical site origin used in invite links and absolute URLs (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare Turnstile site key (optional in local if BOOKING_TURNSTILE_BYPASS=true)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Required (server-only — never prefix with NEXT_PUBLIC_) ------------------
# Supabase service-role key (Settings → API). Server only; bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key for booking emails (optional in local if you skip email)
RESEND_API_KEY=
# From address for Resend (e.g. Merevo Bookings <bookings@yourdomain.com>)
EMAIL_FROM=

# Cloudflare Turnstile secret (required in production; fail closed if missing)
TURNSTILE_SECRET_KEY=

# Upstash Redis for durable booking rate limits (required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# HMAC secret for hashing rate-limit identifiers (16+ chars; required in production)
BOOKING_RATE_LIMIT_SECRET=

# Trusted client IP source for rate limiting / Turnstile remoteip.
# cloudflare → CF-Connecting-IP only (required when DNS is orange-cloud proxied)
# vercel → x-vercel-forwarded-for / x-real-ip
# none → do not trust X-Forwarded-For (safe default / local)
TRUSTED_PROXY=none

# --- Local development only (never set in production) -------------------------
# BOOKING_TURNSTILE_BYPASS=true
#
# Rate limiting:
# - Production requires UPSTASH_REDIS_REST_URL + TOKEN + BOOKING_RATE_LIMIT_SECRET
#   (fail closed with a generic retry message if missing or Redis unavailable)
# - Local without Upstash: in-memory fallback (not safe across instances)
#
# Turnstile:
# - Production requires TURNSTILE_SECRET_KEY (fail closed if missing)
# - Local without secret: verification skipped (documented bypass)
# - Use separate development and production Turnstile key pairs
#
# Cloudflare edge setup (manual): see docs/cloudflare.md
